NODE_ENV=development
PORT=3000
# Local listener; isolated VPS deployment sets 127.0.0.1 through PM2.
HOST=0.0.0.0
API_PREFIX=api/v1

# PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jampic_local
DB_USER=tu_user
DB_PASSWORD=tu_password
DB_SSL=disable

# Base administrativa usada por npm run db:create para crear DB_NAME si no existe.
DB_ADMIN_DATABASE=postgres
# Override opcional para conexión administrativa.
# DB_ADMIN_URL=postgresql://tu_user:tu_password@localhost:5432/postgres

# Si DATABASE_URL está definida, tiene prioridad sobre DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# DATABASE_URL=postgresql://tu_user:tu_password@localhost:5432/jampic_local

# Activar solo una vez en una base local nueva/recreada para cargar usuarios de prueba.
# Después volver a false para que no intente reprocesar seeds locales.
DB_APPLY_LOCAL_SEEDS=false
# En producción valida que el usuario runtime no pueda eludir RLS.
DB_ENFORCE_RLS_ROLE=true

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Clave privada para cifrar secretos MFA. Nunca se comparte con APP-MVP.
MFA_ENCRYPTION_KEY=replace-with-random-value-at-least-32-chars

# Proveedor SMS HTTP. Debe aceptar POST JSON {to,message,sender} con Bearer token.
SMS_ENABLED=false
SMS_API_URL=https://sms-provider.example/v1/messages
SMS_API_TOKEN=replace-with-private-sms-token
SMS_SENDER=DocIA

# Firebase Cloud Messaging para notificaciones push del celular.
# Con FCM_ENABLED=false la app conserva solo notificaciones internas.
FCM_ENABLED=true
FCM_PROJECT_ID=docia-firebase-project-id
# Opcion A: usar Application Default Credentials / GOOGLE_APPLICATION_CREDENTIALS.
# Si ya tienes GOOGLE_APPLICATION_CREDENTIALS por GCS, puede servir si esa service
# account tiene permiso para Firebase Messaging.
# Opcion B: definir client email/private key de la service account.
# FCM_CLIENT_EMAIL=firebase-adminsdk-xxx@docia.iam.gserviceaccount.com
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional separate account file; otherwise GOOGLE_APPLICATION_CREDENTIALS / ADC.
# FCM_SERVICE_ACCOUNT_PATH=/var/www/docia/secrets/firebase-service-account.json

# Production loads the repository's public configuration from its release via DOCIA_SITES_FILE.
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:5173
WEB_ROUTING_MODE=hash
# Optional EXTRA allowed origins during a transition; PUBLIC_WEB_URL is always included.
CORS_ORIGINS=http://localhost:3000

# Secreto privado usado por la API para la firma de integridad de recetas.
# Generar un valor aleatorio de al menos 32 caracteres. Nunca enviarlo a APP-MVP.
PRESCRIPTION_SIGNING_SECRET=replace-with-random-value-at-least-32-chars

# Archivos privados.
# STORAGE_PROVIDER=local guarda archivos nuevos en STORAGE_ROOT.
# STORAGE_PROVIDER=gcs guarda archivos nuevos en Google Cloud Storage.
# Se puede volver de gcs a local cambiando esta variable y reiniciando la API,
# pero los archivos ya subidos al bucket no se copian automáticamente al disco.
# Para volver completamente a local hay que migrar/copiar esos objetos manteniendo
# la misma key interna, por ejemplo payment_receipts/uuid.pdf.
STORAGE_PROVIDER=local
# Ruta usada sólo cuando STORAGE_PROVIDER=local. En VPS usar una ruta persistente
# fuera del repositorio, por ejemplo /var/www/docia/storage.
STORAGE_ROOT=storage
STORAGE_MAX_FILE_SIZE_MB=10
# Cuota acumulada por usuario en una ventana de 24 horas.
STORAGE_DAILY_UPLOAD_MB=100
STORAGE_SIGNING_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters
STORAGE_SIGNED_URL_EXPIRES_SECONDS=300
# Usar sólo cuando STORAGE_PROVIDER=gcs. El bucket debe ser privado.
GCS_BUCKET_NAME=docia-production-files
# En VPS apunta al JSON privado de la service account. No se sube al repositorio.
# La carpeta secrets es externa al repositorio de API.
GOOGLE_APPLICATION_CREDENTIALS=/var/www/docia/secrets/gcs-service-account.json
# PUBLIC_API_URL is defined with the other base URLs above.
EXTERNAL_HTTP_TIMEOUT_MS=15000

# Stripe. Secret key y webhook secret son privados y solo viven en la API.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace-with-private-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-private-stripe-webhook-secret
# Flutter Web usa rutas hash por defecto. Si configuras PathUrlStrategy y rewrites
# en hosting, puedes usar /payments/return sin #.
# Optional override; otherwise derived from PUBLIC_WEB_URL and WEB_ROUTING_MODE.
# STRIPE_PAYMENT_RETURN_URL=https://app.example.com/#/payments/return

# Correo transaccional con Resend. La API key nunca se comparte con APP-MVP.
# Para enviar a cualquier destinatario, verificar el dominio usado en EMAIL_FROM.
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_replace-with-private-resend-key
EMAIL_FROM=Doc IA <no-reply@tu-dominio.com>
# Ruta pública de APP-MVP que recibe ?token=... para cambiar la contraseña.
# PASSWORD_RESET_URL=https://app.example.com/#/password-reset
# Ruta de APP-MVP que recibe ?token=... para completar el registro.
# REGISTRATION_URL=https://app.example.com/#/register/complete

# OpenAI. La clave es privada y solo se configura en la API.
# Mantener AI_ENABLED=false hasta integrar el adaptador conversacional.
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-private-openai-key
OPENAI_MODEL=gpt-5.6-terra
# Opcionales según la cuenta de OpenAI.
# OPENAI_PROJECT_ID=proj_...
# OPENAI_ORGANIZATION_ID=org_...

# Google Maps para operaciones del servidor, como geocodificación o rutas.
# No reemplaza las keys restringidas por plataforma que pueda necesitar el
# renderizado del mapa en Android, iOS o web.
MAPS_ENABLED=false
MAPS_PROVIDER=google
GOOGLE_MAPS_SERVER_API_KEY=replace-with-private-server-key

# Google Meet mediante OAuth 2.0. Client secret y clave de cifrado solo API.
# El callback se deriva de PUBLIC_API_URL + API_PREFIX. Solo define el override
# opcional si Google requiere otra ruta; en producción nunca debe ser localhost.
TELEMEDICINE_ENABLED=false
TELEMEDICINE_PROVIDER=google_meet
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-private-google-oauth-secret
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback
# Generar un valor aleatorio de al menos 32 caracteres para cifrar tokens OAuth.
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-random-value-at-least-32-chars
