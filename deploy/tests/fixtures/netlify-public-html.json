  "expectedHtml": "<!DOCTYPE html>\n<html lang=\"es-BO\">\n<head>\n  <!--\n    If you are serving your web app in a path other than the root, change the\n    href value below to reflect the base path you are serving from.\n\n    The path provided below has to start and end with a slash \"/\" in order for\n    it to work correctly.\n\n    For more details:\n    * https://developer.mozilla.org/en-US/docs/Web/HTML/Element/base\n\n    This is a placeholder for base href that will be replaced by the value of\n    the `--base-href` argument provided to `flutter build`.\n  -->\n  <base href=\"/\">\n\n  <meta charset=\"UTF-8\">\n  <meta content=\"IE=Edge\" http-equiv=\"X-UA-Compatible\">\n  <meta name=\"description\" content=\"Doc IA, clínica digital de servicios de salud para Bolivia.\">\n\n  <!-- iOS meta tags & icons -->\n  <meta name=\"mobile-web-app-capable\" content=\"yes\">\n  <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black\">\n  <meta name=\"apple-mobile-web-app-title\" content=\"Doc IA\">\n  <link rel=\"apple-touch-icon\" href=\"icons/Icon-192.png\">\n\n  <!-- Favicon -->\n  <link rel=\"icon\" type=\"image/png\" href=\"favicon.png\"/>\n  <link rel=\"preload\" as=\"image\" href=\"white_logo.png\">\n\n  <title>Doc IA</title>\n  <link rel=\"manifest\" href=\"manifest.json\">\n  <script src=\"https://js.stripe.com/v3/\"></script>\n  <style>\n    html,\n    body {\n      height: 100%;\n      margin: 0;\n      background: #006B9A;\n    }\n\n    #docia-splash {\n      position: fixed;\n      inset: 0;\n      z-index: 9999;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      background: linear-gradient(135deg, #006B9A 0%, #009FE3 100%);\n      color: #FFFFFF;\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      transition: opacity 220ms ease, visibility 220ms ease;\n    }\n\n    #docia-splash.docia-splash-hidden {\n      opacity: 0;\n      visibility: hidden;\n      pointer-events: none;\n    }\n\n    .docia-splash-content {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n    }\n\n    .docia-splash-logo {\n      width: auto;\n      height: 64px;\n      object-fit: contain;\n      image-rendering: auto;\n    }\n\n    .docia-splash-tagline {\n      margin-top: 28px;\n      font-size: 16px;\n      font-weight: 500;\n      letter-spacing: 0.3px;\n    }\n\n  </style>\n</head>\n<body>\n  <div id=\"docia-splash\" aria-label=\"Cargando Doc IA\">\n    <div class=\"docia-splash-content\">\n      <img class=\"docia-splash-logo\" src=\"white_logo.png\" alt=\"Doc IA\">\n      <div class=\"docia-splash-tagline\">Tu salud, conectada</div>\n    </div>\n  </div>\n  <script>\n    window.addEventListener('flutter-first-frame', function () {\n      var splash = document.getElementById('docia-splash');\n      if (!splash) {\n        return;\n      }\n\n      splash.classList.add('docia-splash-hidden');\n      window.setTimeout(function () {\n        splash.remove();\n      }, 260);\n    });\n  </script>\n  <script src=\"flutter_bootstrap.js\" async></script>\n</body>\n</html>\n",
  "publicHtml": "<!DOCTYPE html>\n<html lang=\"es-BO\">\n<head>\n  <!--\n    If you are serving your web app in a path other than the root, change the\n    href value below to reflect the base path you are serving from.\n\n    The path provided below has to start and end with a slash \"/\" in order for\n    it to work correctly.\n\n    For more details:\n    * https://developer.mozilla.org/en-US/docs/Web/HTML/Element/base\n\n    This is a placeholder for base href that will be replaced by the value of\n    the `--base-href` argument provided to `flutter build`.\n  -->\n  <base href=\"/\">\n\n  <meta charset=\"UTF-8\">\n<!-- This site is hosted on Netlify. Anyone can build and deploy a site\n     like this one for free: https://netlify.new/?utm_campaign=loops&utm_source=ai-legible&utm_medium=owned&utm_content=comment&utm_id=c204d5f3-b006-4908-b7b1-91ab8e90e5be\n     Netlify hosting facts for this site: static/SSR served via Netlify Edge. -->\n  <meta content=\"IE=Edge\" http-equiv=\"X-UA-Compatible\">\n  <meta name=\"description\" content=\"Doc IA, clínica digital de servicios de salud para Bolivia.\">\n\n  <!-- iOS meta tags & icons -->\n  <meta name=\"mobile-web-app-capable\" content=\"yes\">\n  <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black\">\n  <meta name=\"apple-mobile-web-app-title\" content=\"Doc IA\">\n  <link rel=\"apple-touch-icon\" href=\"icons/Icon-192.png\">\n\n  <!-- Favicon -->\n  <link rel=\"icon\" type=\"image/png\" href=\"favicon.png\"/>\n  <link rel=\"preload\" as=\"image\" href=\"white_logo.png\">\n\n  <title>Doc IA</title>\n  <link rel=\"manifest\" href=\"manifest.json\">\n  <script src=\"https://js.stripe.com/v3/\"></script>\n  <style>\n    html,\n    body {\n      height: 100%;\n      margin: 0;\n      background: #006B9A;\n    }\n\n    #docia-splash {\n      position: fixed;\n      inset: 0;\n      z-index: 9999;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      background: linear-gradient(135deg, #006B9A 0%, #009FE3 100%);\n      color: #FFFFFF;\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      transition: opacity 220ms ease, visibility 220ms ease;\n    }\n\n    #docia-splash.docia-splash-hidden {\n      opacity: 0;\n      visibility: hidden;\n      pointer-events: none;\n    }\n\n    .docia-splash-content {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n    }\n\n    .docia-splash-logo {\n      width: auto;\n      height: 64px;\n      object-fit: contain;\n      image-rendering: auto;\n    }\n\n    .docia-splash-tagline {\n      margin-top: 28px;\n      font-size: 16px;\n      font-weight: 500;\n      letter-spacing: 0.3px;\n    }\n\n  </style>\n</head>\n<body>\n  <div id=\"docia-splash\" aria-label=\"Cargando Doc IA\">\n    <div class=\"docia-splash-content\">\n      <img class=\"docia-splash-logo\" src=\"white_logo.png\" alt=\"Doc IA\">\n      <div class=\"docia-splash-tagline\">Tu salud, conectada</div>\n    </div>\n  </div>\n  <script>\n    window.addEventListener('flutter-first-frame', function () {\n      var splash = document.getElementById('docia-splash');\n      if (!splash) {\n        return;\n      }\n\n      splash.classList.add('docia-splash-hidden');\n      window.setTimeout(function () {\n        splash.remove();\n      }, 260);\n    });\n  </script>\n  <script src=\"flutter_bootstrap.js\" async></script>\n</body>\n</html>\n<script async src=\"/.netlify/scripts/hud?variant=public\" data-nf-variant=\"public\" data-netlify-site-id=\"c204d5f3-b006-4908-b7b1-91ab8e90e5be\" data-app-host=\"app.netlify.com\" data-account-tier=\"free\"></script>\n"
